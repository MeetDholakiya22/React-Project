```gitignore
# =================================
# Dependencies (Frontend + Backend)
# =================================
node_modules/
**/node_modules/

# =================================
# Build Files
# =================================
dist/
dist-ssr/
build/
**/dist/
**/build/

# =================================
# Environment Variables
# =================================
.env
.env.*
!.env.example
*.local

# =================================
# Logs
# =================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =================================
# Editor Directories and Files
# =================================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# =================================
# Operating System Files
# =================================
.DS_Store
Thumbs.db
desktop.ini
```
